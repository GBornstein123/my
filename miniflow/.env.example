# Copy to .env (same folder, or %APPDATA%\miniflow\.env for installed builds).
# Keys live here or in real environment variables — never in settings.json.

# Cloud transcription — one of these, matching the provider in the tray menu:
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: enables Claude Haiku cleanup. Without it MiniFlow uses the
# offline rules cleaner (fillers, punctuation, self-corrections).
ANTHROPIC_API_KEY=
