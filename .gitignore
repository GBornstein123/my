# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bulk update run artifacts (contain episode/video content, not secrets)
/scripts/simplecast/runs/
/scripts/youtube/runs/

# youtube oauth credentials — never commit these
/scripts/youtube/client_secrets.json
/scripts/youtube/.token.json
/scripts/**/affiliate-block*.txt
/scripts/**/affiliate-block*.html
!/scripts/**/affiliate-block.example.txt